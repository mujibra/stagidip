enum POStatus {
  DRAFT
  CONFIRMED
  STAGING
  DELIVERING
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id         Int      @id @default(autoincrement())
  poNumber   String   @unique
  customerId Int
  status     POStatus
  orderDate  DateTime
  notes      String?

  customer Customer @relation(fields: [customerId], references: [id])

  lines PurchaseOrderLine[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  machineInstances MachineInstance[]
  deliveryPlans    DeliveryPlan[]
}

model PurchaseOrderLine {
  id              Int   @id @default(autoincrement())
  purchaseOrderId Int
  machineDefId    Int
  quantity        Int
  serialNumbers   Json?
  configuration   Json?

  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  machineDef    MachineDefinition @relation(fields: [machineDefId], references: [id])

  machineInstances MachineInstance[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?
  createdAt DateTime @default(now())

  orders PurchaseOrder[]
  users  User[]
}

enum MachineStatus {
  PLANNED // created from PO line
  STAGING
  READY
  IN_TRANSIT
  DELIVERED
  INSTALLED
  REJECTED
}

model MachineDefinition {
  id                 Int                 @id @default(autoincrement())
  brand              String
  model              String
  type               String
  machineInstances   MachineInstance[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([brand, model, type])
}

model MachineInstance {
  id                  Int           @id @default(autoincrement())
  purchaseOrderId     Int
  purchaseOrderLineId Int
  machineDefId        Int
  serialNumber        String?
  status              MachineStatus

  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  definition        MachineDefinition @relation(fields: [machineDefId], references: [id])

  // NO workflow arrays here

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  partInstances    PartInstance[]
  checklistResults ChecklistResult[]
  inspections      Inspection[]
  deliveryEvents   DeliveryEvent[]

  @@index([purchaseOrderId])
  @@index([purchaseOrderLineId])
  @@index([serialNumber])
}

model PartDefinition {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  name          String
  partInstances PartInstance[]
}

model PartInstance {
  id        Int @id @default(autoincrement())
  machineId Int
  partDefId Int

  serialNumber String?
  partNumber   String?
  pm           String?

  machine    MachineInstance @relation(fields: [machineId], references: [id])
  definition PartDefinition  @relation(fields: [partDefId], references: [id])

  @@unique([machineId, partDefId])
}

model ChecklistDefinition {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  description      String
  machineType      String
  checklistResults ChecklistResult[]
}

enum CheckResult {
  PASS
  FAIL
  NA
}

model ChecklistResult {
  id             Int         @id @default(autoincrement())
  machineId      Int
  checklistDefId Int
  result         CheckResult
  notes          String?

  machine   MachineInstance     @relation(fields: [machineId], references: [id])
  checklist ChecklistDefinition @relation(fields: [checklistDefId], references: [id])

  @@unique([machineId, checklistDefId])
}

enum InspectionStatus {
  PENDING
  PASSED
  FAILED
}

model Inspection {
  id          Int              @id @default(autoincrement())
  machineId   Int
  status      InspectionStatus
  inspectorId Int?
  inspectedAt DateTime?

  machine MachineInstance @relation(fields: [machineId], references: [id])
}

model Warehouse {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  name    String
  address String?

  createdAt DateTime @default(now())

  // relations
  users User[]

  deliveryPlansFrom DeliveryPlan[] @relation("FromPlan")
  deliveryPlansTo   DeliveryPlan[] @relation("ToPlan")
}

enum DeliveryPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryEventType {
  DISPATCHED
  ARRIVED
}

model DeliveryPlan {
  id              Int                @id @default(autoincrement())
  purchaseOrderId Int
  fromWarehouseId Int
  toWarehouseId   Int
  plannedDate     DateTime?
  status          DeliveryPlanStatus

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  fromWarehouse Warehouse     @relation("FromPlan", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse     @relation("ToPlan", fields: [toWarehouseId], references: [id])

  events DeliveryEvent[]
}

model DeliveryEvent {
  id             Int               @id @default(autoincrement())
  deliveryPlanId Int
  machineId      Int
  eventType      DeliveryEventType
  eventTime      DateTime          @default(now())
  notes          String?

  deliveryPlan DeliveryPlan    @relation(fields: [deliveryPlanId], references: [id])
  machine      MachineInstance @relation(fields: [machineId], references: [id])
}

